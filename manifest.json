{
  "manifest_version": 3,
  "name": "YouTube Language Sidebar",
  "version": "0.4.0",
  "description": "Language-Reactor-style subtitle sidebar for YouTube, Netflix and Prime Video. Star a phrase to save its text and a real audio clip of that exact time range.",
  "permissions": ["storage"],
  "host_permissions": [
    "*://*.youtube.com/*",
    "*://*.netflix.com/*",
    "*://*.nflxvideo.net/*",
    "*://*.primevideo.com/*",
    "*://*.amazon.com/*",
    "*://*.media-amazon.com/*",
    "*://*.amazonvideo.com/*",
    "*://*.aiv-cdn.net/*",
    "*://*.aiv-delivery.net/*",
    "*://*.cloudfront.net/*"
  ],
  "action": { "default_title": "Saved clips library" },
  "background": { "service_worker": "src/background.js" },
  "content_scripts": [
    {
      "matches": ["*://www.youtube.com/*"],
      "js": ["src/inject.js"],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": ["*://www.youtube.com/*"],
      "js": [
        "src/db.js",
        "src/settings.js",
        "src/captions.js",
        "src/audio.js",
        "src/library.js",
        "src/clip-extractor.js",
        "src/youtube.js",
        "src/core.js"
      ],
      "css": ["src/sidebar.css"],
      "run_at": "document_idle",
      "world": "ISOLATED"
    },
    {
      "matches": ["*://www.netflix.com/*"],
      "js": ["src/netflix-inject.js"],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": ["*://www.netflix.com/*"],
      "js": [
        "src/db.js",
        "src/settings.js",
        "src/captions.js",
        "src/audio.js",
        "src/library.js",
        "src/mp4.js",
        "src/clip-extractor.js",
        "src/netflix.js",
        "src/core.js"
      ],
      "css": ["src/sidebar.css"],
      "run_at": "document_idle",
      "world": "ISOLATED"
    },
    {
      "matches": ["*://www.primevideo.com/*", "*://www.amazon.com/gp/video/*"],
      "js": ["src/prime-inject.js"],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": ["*://www.primevideo.com/*", "*://www.amazon.com/gp/video/*"],
      "js": [
        "src/db.js",
        "src/settings.js",
        "src/captions.js",
        "src/audio.js",
        "src/library.js",
        "src/prime.js",
        "src/core.js"
      ],
      "css": ["src/sidebar.css"],
      "run_at": "document_idle",
      "world": "ISOLATED"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": ["src/pcm-worklet.js", "src/library-view.js"],
      "matches": [
        "*://*.youtube.com/*",
        "*://*.netflix.com/*",
        "*://*.primevideo.com/*",
        "*://*.amazon.com/*"
      ]
    }
  ]
}
